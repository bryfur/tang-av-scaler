# UART0's default pads (D6/D7) are the FPGA's UART and the USB port carries the FPGA's console
# too: nothing of the ESP's own on either (its log is kept in RAM: GET /api/log)
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# An update that does not come up (Wi-Fi, the web server) is rolled back at the next reset
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# (the web server's seven and its own three, the console's and the JTAG server's listeners and
# clients: with lwIP's ten a browser or two could hold every one, and nothing more was answered)
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
# A hung firmware restarts by itself: nobody is there to replug it
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# The XIAO's PSRAM (8 MB on the ESP32-C5, as on the ESP32-S3) as heap: without it Wi-Fi, lwIP's
# windows and the buffers here leave about 17 KB of the chip's own RAM, and the access point cannot
# give a client an address (2026-11-11: no DHCP lease, "incorrect password" on a phone).  Wi-Fi's
# and lwIP's buffers may go there; small blocks stay inside
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# ... and the firmware's own large buffers are there too (app.h big(): allocated there, not static):
# the chip's own RAM is what Wi-Fi's fixed buffers and the tasks' stacks need, and it had run out
# (2026-11-13: some 11 KB more of static buffers here, and a new firmware could not join the network
# (no memory to authenticate), then crashed opening its access point (no beacon buffer)).
# GET /api/status says what is left: "heap_int", and the least it has been: "heap_int_min".
# (Not CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY: that moves Wi-Fi's and lwIP's own variables
# into the PSRAM as well.)
# Bluetooth LE (ble.c): NimBLE, a peripheral only (the phone connects); the host's memory in the
# PSRAM, like the rest (the chip's own RAM is short).  Two phones, four L2CAP channels (each one a
# connection to the web server), bonds kept in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=4
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=48
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=512
# (what Bluetooth needs of the chip's own RAM, some 55 KB, given back by Wi-Fi's and lwIP's code
# leaving it: as Espressif's own Wi-Fi + Bluetooth example has it; tasks that never touch the flash
# have their stacks in the PSRAM too: console.c, xvc.c, ble.c)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
