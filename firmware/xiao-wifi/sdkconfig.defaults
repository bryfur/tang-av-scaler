# UART0's default pads (D6/D7) are the FPGA's UART and the USB port carries the FPGA's console
# too: nothing of the ESP's own on either (its log is kept in RAM: GET /api/log)
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# An update that does not come up (Wi-Fi, the web server) is rolled back at the next reset
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# (the web server's seven and its own three, the console's and the JTAG server's listeners and
# clients: with lwIP's ten a browser or two could hold every one, and nothing more was answered)
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
# A hung firmware restarts by itself: nobody is there to replug it
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# The XIAO's PSRAM (8 MB on the ESP32-C5, as on the ESP32-S3) as heap: without it Wi-Fi, lwIP's
# windows and the buffers here leave about 17 KB of the chip's own RAM, and the access point cannot
# give a client an address (2026-11-11: no DHCP lease, "incorrect password" on a phone).  Wi-Fi's
# and lwIP's buffers may go there; small blocks stay inside
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
