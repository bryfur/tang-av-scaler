# vendors' documents (copyright): fetched, not committed
hardware/*/refs/

# KiCad and the generator's by-products
*.kicad_prl
*-backups/
fp-info-cache
*.dsn
*.ses
route.log
*-route.log
hardware/**/logs/
drc.rpt
__pycache__/

# 3D models from LCSC (60 MB): fetched by hardware/av-board/kit/fetch_lib.sh
hardware/*/lib/*.3dshapes/

# fab outputs: the zip, BOM and CPL are kept; the loose Gerbers are in the zip
hardware/**/fab/gerbers/
