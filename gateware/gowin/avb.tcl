# The AV board's bring-up image through Gowin's flow (1.9.12 Standard):
#
#   gw_sh gowin/avb.tcl            (from gateware/, in the fpga-tools container)
#
#   GW_OUT    the project directory (gateware/gowin/build/avb)
#   GW_DEVVER the device version (C: check the SOM's chip marking)
#   GW_MODE   the picture: 1080p60 (1.485 Gb/s, 10-bit words), 2160p30 (2.97 Gb/s, 20-bit words) or
#             2160p60 (5.94 Gb/s, 20-bit words two a clock)

proc env {name default} {
    if {[info exists ::env($name)] && $::env($name) ne ""} { return $::env($name) }
    return $default
}
set here [file dirname [file normalize [info script]]]
set gw   [file dirname $here]
set out  [file normalize [env GW_OUT $here/build/avb]]
file mkdir $out

set f [open $out/defines.v w]
puts $f "// generated by gateware/gowin/avb.tcl"
#   GW_BUILD  the build's number, as the design says it (register 01).  It is a constant in the
#             logic, and with another number the synthesis gives another netlist: another placement,
#             other timing (with the time of the build for it, a design that closed did not close
#             again a minute later; with the same number, the same result to the last digit, on
#             either build machine).  So the number belongs to the sources:
#               gowin/build.stamp   "NUMBER PLACE ROUTE SUM": a number and the place and route
#                                   options that close the timing for the logic's sources whose
#                                   checksum is SUM (rtl/, the pins and timing constraints, the
#                                   tables' makers).  While the sources are those, a build is that
#                                   one again; a new CPU program alone (sw/: block RAM contents)
#                                   changes nothing.
#               else                the time of the newest of those sources (as sw/Makefile's
#                                   number is the program's), GW_PLACE 3, GW_ROUTE 1.
#             Each build leaves its own "NUMBER PLACE ROUTE SUM" in its directory (build.stamp):
#             copy a closing build's to gowin/build.stamp.  After a change that does not close:
#             the pairs (2, 1) (2, 2) (3, 1) (3, 2), and GW_BUILD a second on for as many tries
#             more (place 0, 1 and 4 never have closed).
set srcs [lsort [concat [glob $gw/rtl/*.v $gw/rtl/ddr3/*.v] [list $here/avb.cst $here/avb.sdc $gw/sim/fsr.py $gw/sim/smaa.py $gw/rtl/osd_font.hex]]]
set newest 0
foreach src $srcs {
    if {[file mtime $src] > $newest} { set newest [file mtime $src] }
}
set sum [lindex [exec sh -c "cat $srcs | sha256sum"] 0]
set number $newest
set place 3
set route 1
if {[file exists $here/build.stamp]} {
    set fi [open $here/build.stamp]; set st [split [string trim [read $fi]]]; close $fi
    if {[llength $st] == 4 && [lindex $st 3] eq $sum} {
        lassign $st number place route
        puts "avb.tcl: the sources are gowin/build.stamp's: build $number, place $place, route $route"
    } else {
        puts "avb.tcl: the sources have changed since gowin/build.stamp: build $number (their newest's time); once a build of them closes, copy its build.stamp there"
    }
}
set number [env GW_BUILD $number]
set place [env GW_PLACE $place]
set route [env GW_ROUTE $route]
set fo [open $out/build.stamp w]; puts $fo "$number $place $route $sum"; close $fo
puts $f "`define AVB_BUILD 32'd$number"
set mode [env GW_MODE 1080p60]
switch $mode {
    1080p60 { set ppc 1; set serdes {1.485G 148.5M 10 1:1} }
    2160p30 { set ppc 2; set serdes {2.97G 148.5M 20 1:1} }
    2160p60 { set ppc 4; set serdes {5.94G 148.5M 20 1:2} }
    default { error "GW_MODE: 1080p60, 2160p30 or 2160p60" }
}
puts $f "`define AVB_PPC $ppc"
# the scaler's table (sim/fsr.py table)
exec python3 $gw/sim/fsr.py table $out/easu >@ stdout
foreach k {0 1 2 3} { puts $f "`define EASU_HEX$k \"$out/easu$k.hex\"" }
# the anti-aliasing's area table (sim/smaa.py table)
exec python3 $gw/sim/smaa.py table $out/smaa.hex $out/smaad.hex $out/smaah.hex
puts $f "`define SMAA_HEX \"$out/smaa.hex\""
puts $f "`define SMAA_DHEX \"$out/smaad.hex\""
puts $f "`define SMAA_HHEX \"$out/smaah.hex\""
# the on-screen text's font (kept in the tree: tools/mkfont.py) and the CPU's program (sw/: make)
puts $f "`define OSD_FONT \"$gw/rtl/osd_font.hex\""
file copy -force [env GW_CPU $gw/sw/build/cpu.hex] $out/cpu.hex
puts $f "`define CPU_HEX \"$out/cpu.hex\""
close $f

cd $out
create_project -name avb -dir $out -pn GW5AST-LV138PG484AC1/I0 -device_version [env GW_DEVVER C] -force
cd $out/avb
add_file -type verilog $out/defines.v
#   GW_SRCS   the sources, from gateware/ (default: the bring-up image's; a test's: test/loop.v)
foreach f [env GW_SRCS {rtl/top.v rtl/sys_pll.v rtl/mon.v rtl/uart.v rtl/fmeter.v rtl/gtx_quad.v rtl/pattern.v rtl/hdmi_scr.v rtl/tmds.v rtl/cpu.v rtl/cpu_ddr.v rtl/spis.v rtl/osd.v rtl/vcap.v rtl/border.v rtl/focus.v rtl/grab.v rtl/cap_ddr.v rtl/deint.v rtl/pthru.v rtl/audio_fifo.v rtl/lstream.v rtl/smaa.v rtl/easu.v rtl/rcas.v rtl/dline.v rtl/audio_in.v rtl/hdmi_audio.v rtl/ddr_arb.v rtl/ddr3/ddr3_top.v rtl/ddr3/ddr3_ctl.v rtl/ddr3/ddr3_cal.v rtl/ddr3/ddr3_dp.v rtl/ddr3/ddr3_phy.v rtl/ddr3/ddr_pll.v rtl/ddr3/pll_init.v}] {
    add_file -type verilog $gw/$f
}
# the hard CPU's SoC (Gowin's RiscV_AE350_SOC, from the IDE's own files: its top in plain Verilog, the rest
# encrypted; rtl/riscv_ae350_config.v and rtl/gw_dtcm_config.v are what its generator would write)
if {[env GW_CST ""] eq ""} {
    set ip [env GW_IP [file normalize ~/tools/gowin-standard-1.9.12.04/IDE/ipcore/RiscV_AE350_SOC/data]]
    foreach f {riscv_ae350_top.v riscv_ae350_soc.v} { add_file -type verilog $ip/$f }
}
#   GW_CST    the pins (gowin/avb.cst); a test's own: no clock constraints with it
# the transceivers' register file (gowin/serdes.py): the place and route takes it with the design
exec python3 $here/serdes.py $out/serdes {*}$serdes >@ stdout
if {[env GW_CST ""] ne ""} {
    add_file -type cst $gw/[env GW_CST ""]
} else {
    add_file -type cst $here/avb.cst
    add_file -type sdc $here/avb.sdc
}

set_option -synthesis_tool gowinsynthesis
set_option -top_module top
set_option -verilog_std v2001
set_option -include_path "$gw/rtl;$out"
set_option -multi_file_compilation_unit 1
# IN_SCL/IN_SDA and the VGA DDC sit on the slave-SPI configuration pins, the I2C pins are I/O
set_option -use_mspi_as_gpio 1
set_option -use_sspi_as_gpio 1
set_option -use_i2c_as_gpio 1
set_option -use_cpu_as_gpio 1
# (not compressed: openFPGALoader 1.1.1 cannot parse a compressed GW5AST .fs)
set_option -bit_compress 0
set_option -timing_driven 1
#   GW_PLACE, GW_ROUTE  the place and route algorithms (as gowin/build.stamp says, or 3 and 1: above)
set_option -place_option $place
set_option -route_option $route
set_option -output_base_name avb
# (the register file is a result file of the project, not a source: gw_sh has no command for it)
# (so: the project is made here, build.sh names the file in it with csr_result.py, and
# gowin/run.tcl opens the project again and runs it)
if {[env GW_CST ""] ne ""} { run all }
