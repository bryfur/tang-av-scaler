# The AV board's bring-up image through Gowin's flow (1.9.12 Standard):
#
#   gw_sh gowin/avb.tcl            (from gateware/, in the fpga-tools container)
#
#   GW_OUT    the project directory (gateware/gowin/build/avb)
#   GW_DEVVER the device version (C: check the SOM's chip marking)
#   GW_MODE   the picture: 1080p60 (1.485 Gb/s, 10-bit words), 2160p30 (2.97 Gb/s, 20-bit words) or
#             2160p60 (5.94 Gb/s, 20-bit words two a clock)

proc env {name default} {
    if {[info exists ::env($name)] && $::env($name) ne ""} { return $::env($name) }
    return $default
}
set here [file dirname [file normalize [info script]]]
set gw   [file dirname $here]
set out  [file normalize [env GW_OUT $here/build/avb]]
file mkdir $out

set f [open $out/defines.v w]
puts $f "// generated by gateware/gowin/avb.tcl"
puts $f "`define AVB_BUILD 32'd[exec date +%s]"
set mode [env GW_MODE 1080p60]
switch $mode {
    1080p60 { set ppc 1; set serdes {1.485G 148.5M 10 1:1} }
    2160p30 { set ppc 2; set serdes {2.97G 148.5M 20 1:1} }
    2160p60 { set ppc 4; set serdes {5.94G 148.5M 20 1:2} }
    default { error "GW_MODE: 1080p60, 2160p30 or 2160p60" }
}
puts $f "`define AVB_PPC $ppc"
close $f

cd $out
create_project -name avb -dir $out -pn GW5AST-LV138PG484AC1/I0 -device_version [env GW_DEVVER C] -force
cd $out/avb
add_file -type verilog $out/defines.v
#   GW_SRCS   the sources, from gateware/ (default: the bring-up image's; a test's: test/loop.v)
foreach f [env GW_SRCS {rtl/top.v rtl/sys_pll.v rtl/mon.v rtl/uart.v rtl/fmeter.v rtl/gtx_quad.v rtl/pattern.v rtl/hdmi_scr.v rtl/tmds.v rtl/vcap.v rtl/fbram.v rtl/fbview.v}] {
    add_file -type verilog $gw/$f
}
#   GW_CST    the pins (gowin/avb.cst); a test's own: no clock constraints with it
# the transceivers' register file (gowin/serdes.py): the place and route takes it with the design
exec python3 $here/serdes.py $out/serdes {*}$serdes >@ stdout
if {[env GW_CST ""] ne ""} {
    add_file -type cst $gw/[env GW_CST ""]
} else {
    add_file -type cst $here/avb.cst
    add_file -type sdc $here/avb.sdc
}

set_option -synthesis_tool gowinsynthesis
set_option -top_module top
set_option -verilog_std v2001
set_option -multi_file_compilation_unit 1
# IN_SCL/IN_SDA and the VGA DDC sit on the slave-SPI configuration pins, the I2C pins are I/O
set_option -use_mspi_as_gpio 1
set_option -use_sspi_as_gpio 1
set_option -use_i2c_as_gpio 1
set_option -use_cpu_as_gpio 1
# (not compressed: openFPGALoader 1.1.1 cannot parse a compressed GW5AST .fs)
set_option -bit_compress 0
set_option -timing_driven 1
set_option -output_base_name avb
# (the register file is a result file of the project, not a source: gw_sh has no command for it)
# (so: the project is made here, build.sh names the file in it with csr_result.py, and
# gowin/run.tcl opens the project again and runs it)
if {[env GW_CST ""] ne ""} { run all }
