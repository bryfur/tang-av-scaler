// avb.cst: the pins the bring-up image uses, as in hardware/av-board/rev-cb/fpga/av-board-cb.cst
// (generated from the board), and the SOM's 50 MHz oscillator
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "esp_tx" V20;  // J22 pin 6, bank 4, GCLKC_8 SGCLKC_5
IO_PORT "esp_tx" IO_TYPE=LVCMOS33;
IO_LOC "esp_rx" M17;  // J22 pin 10, bank 3
IO_PORT "esp_rx" IO_TYPE=LVCMOS33;
IO_LOC "in_led" E18;  // J20 pin 71, bank 2
IO_PORT "in_led" IO_TYPE=LVCMOS33;
IO_LOC "in_key1" B22;  // J20 pin 75, bank 2
IO_PORT "in_key1" IO_TYPE=LVCMOS33;
IO_LOC "in_key2" C22;  // J20 pin 73, bank 2
IO_PORT "in_key2" IO_TYPE=LVCMOS33;
IO_LOC "pll_scl" G15;  // J21 pin 64, bank 3
IO_PORT "pll_scl" IO_TYPE=LVCMOS33;
IO_LOC "pll_sda" C13;  // J21 pin 55, bank 2
IO_PORT "pll_sda" IO_TYPE=LVCMOS33;
IO_LOC "dp_scl" A14;  // J21 pin 47, bank 2
IO_PORT "dp_scl" IO_TYPE=LVCMOS33;
IO_LOC "dp_sda" B15;  // J21 pin 43, bank 2
IO_PORT "dp_sda" IO_TYPE=LVCMOS33;
IO_LOC "ddc_scl" J14;  // J21 pin 60, bank 3
IO_PORT "ddc_scl" IO_TYPE=LVCMOS33;
IO_LOC "ddc_sda" H14;  // J21 pin 58, bank 3
IO_PORT "ddc_sda" IO_TYPE=LVCMOS33;
IO_LOC "in_scl" W15;  // J22 pin 44, bank 5, SPI_CSN
IO_PORT "in_scl" IO_TYPE=LVCMOS33;
IO_LOC "in_sda" Y16;  // J22 pin 42, bank 5, SPI_MOSI
IO_PORT "in_sda" IO_TYPE=LVCMOS33;
IO_LOC "dp_oe" G16;  // J21 pin 62, bank 3
IO_PORT "dp_oe" IO_TYPE=LVCMOS33;
IO_LOC "dp_hpd" A13;  // J21 pin 49, bank 2
IO_PORT "dp_hpd" IO_TYPE=LVCMOS33;
IO_LOC "cec_fpga" B13;  // J21 pin 53, bank 2
IO_PORT "cec_fpga" IO_TYPE=LVCMOS33;
IO_LOC "in_reset_n" T14;  // J22 pin 90, bank 5
IO_PORT "in_reset_n" IO_TYPE=LVCMOS33;
IO_LOC "in_int" AA13;  // J22 pin 60, bank 5
IO_PORT "in_int" IO_TYPE=LVCMOS33;
IO_LOC "pll_clk2" D17;  // J21 pin 31, bank 2, MGCLKT_1
IO_PORT "pll_clk2" IO_TYPE=LVCMOS33;
IO_LOC "in_llc" V13;  // J22 pin 88, bank 5, MGCLKT_7
IO_PORT "in_llc" IO_TYPE=LVCMOS33;
// the ADV7181D's pixel port: Y on P19-P12, C on P9-P2
IO_LOC "in_y[0]" W10;
IO_PORT "in_y[0]" IO_TYPE=LVCMOS33;
IO_LOC "in_y[1]" V10;
IO_PORT "in_y[1]" IO_TYPE=LVCMOS33;
IO_LOC "in_y[2]" AB12;
IO_PORT "in_y[2]" IO_TYPE=LVCMOS33;
IO_LOC "in_y[3]" Y12;
IO_PORT "in_y[3]" IO_TYPE=LVCMOS33;
IO_LOC "in_y[4]" V14;
IO_PORT "in_y[4]" IO_TYPE=LVCMOS33;
IO_LOC "in_y[5]" Y14;
IO_PORT "in_y[5]" IO_TYPE=LVCMOS33;
IO_LOC "in_y[6]" W14;
IO_PORT "in_y[6]" IO_TYPE=LVCMOS33;
IO_LOC "in_y[7]" V15;
IO_PORT "in_y[7]" IO_TYPE=LVCMOS33;
IO_LOC "in_c[0]" W12;
IO_PORT "in_c[0]" IO_TYPE=LVCMOS33;
IO_LOC "in_c[1]" AA9;
IO_PORT "in_c[1]" IO_TYPE=LVCMOS33;
IO_LOC "in_c[2]" AA10;
IO_PORT "in_c[2]" IO_TYPE=LVCMOS33;
IO_LOC "in_c[3]" K13;
IO_PORT "in_c[3]" IO_TYPE=LVCMOS33;
IO_LOC "in_c[4]" AB10;
IO_PORT "in_c[4]" IO_TYPE=LVCMOS33;
IO_LOC "in_c[5]" AA11;
IO_PORT "in_c[5]" IO_TYPE=LVCMOS33;
IO_LOC "in_c[6]" K14;
IO_PORT "in_c[6]" IO_TYPE=LVCMOS33;
IO_LOC "in_c[7]" AB11;
IO_PORT "in_c[7]" IO_TYPE=LVCMOS33;
IO_LOC "in_de" Y13;
IO_PORT "in_de" IO_TYPE=LVCMOS33;
IO_LOC "in_hs" AB13;
IO_PORT "in_hs" IO_TYPE=LVCMOS33;
IO_LOC "in_vs" AA14;
IO_PORT "in_vs" IO_TYPE=LVCMOS33;
